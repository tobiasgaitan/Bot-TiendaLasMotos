{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/MCP_USAGE_RULES.md"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true,
      "timeout": 15000
    },
    "codegraph": {
      "type": "local",
      "command": ["npx", "-y", "@colbymchenry/codegraph@1.5.0", "serve", "--mcp"],
      "enabled": true,
      "timeout": 30000
    }
  }
}
