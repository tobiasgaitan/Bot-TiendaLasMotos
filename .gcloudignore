# .gcloudignore canónico para GCP Cloud Run Deploy - v10.42.0
.git/
.gcloudignore
.gitignore

# Forzar inclusión obligatoria de la librería offline y sus metadatos locales
!S-TOON-Protocol/
!S-TOON-Protocol/git_dir/
!S-TOON-Protocol/git_dir/**

# Ignorar caches y entornos
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
tests/
.env
.env.*
*.log
